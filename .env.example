# Partner CPA offer URL (the Costco reward page people go to after this bridge)
VITE_OFFER_URL=https://linkthem.net/aff_c?offer_id=941&aff_id=197355

# Mojo admin panel password — required for /mojo login
MOJO_PASSWORD=your-secure-password-here

# Optional JWT secret (defaults to MOJO_PASSWORD if not set)
# MOJO_SECRET=random-long-secret-string

# Server port (use 3000 in Easypanel domain settings)
PORT=3000
